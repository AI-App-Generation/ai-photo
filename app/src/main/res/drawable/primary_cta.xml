<?xml version="1.0" encoding="utf-8"?>
<!-- Nút CTA của quảng cáo: gradient brand 135° (violet → magenta), radius 18dp như AppShapes.button. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ad_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/ad_accent_violet"
                android:endColor="@color/ad_accent_magenta" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
