<?xml version="1.0" encoding="utf-8"?>
<!-- Nền khung quảng cáo đặt GIỮA nội dung (không dính đáy màn): bo 24dp đủ bốn góc. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ad_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/ad_stroke" />
    <corners android:radius="24dp" />
</shape>
