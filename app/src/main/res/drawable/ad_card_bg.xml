<?xml version="1.0" encoding="utf-8"?>
<!-- Nền khung quảng cáo thường: bề mặt tối, viền mảnh, bo 24dp hai góc trên (như thanh nav). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ad_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/ad_stroke" />
    <corners
        android:topLeftRadius="24dp"
        android:topRightRadius="24dp" />
</shape>
