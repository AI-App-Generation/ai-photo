<?xml version="1.0" encoding="utf-8"?>
<!--
    Native ad dạng thanh: chữ bên trái, CTA 84x32 bên phải. Nội dung cao 36dp
    (badge/headline 18 + 2 + body 16); khung frame_ad_small.xml cộng padding 10+10 => 56dp.
    Phải khớp frame_ad_small.xml từng dp.
-->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ad_label"
                    android:layout_width="22dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ad_badge_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Ad"
                    android:textColor="@color/ad_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="0dp"
                    android:layout_height="18dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/ad_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ad_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="84dp"
            android:layout_height="32dp"
            android:background="@drawable/primary_cta"
            android:backgroundTint="@null"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="Install"
            android:textAllCaps="false"
            android:textColor="@color/ad_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
